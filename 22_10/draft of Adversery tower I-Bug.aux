\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Distribution of step counts required to reach the target for successful runs. Across the $1,000,000$ sampled environments, the Cautious strategy exhibited a maximum observed completion time of $578$ steps ($\sim 580$) at the cost of a higher median due to adversarial pausing, whereas the Inertial heuristic minimizes average and median traversal duration among successful runs.}}{13}{figure.caption.3}\protected@file@percent }
\newlabel{fig:steps_dist}{{2}{13}{Distribution of step counts required to reach the target for successful runs. Across the $1,000,000$ sampled environments, the Cautious strategy exhibited a maximum observed completion time of $578$ steps ($\sim 580$) at the cost of a higher median due to adversarial pausing, whereas the Inertial heuristic minimizes average and median traversal duration among successful runs}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Case Study: Cyclic Synchronization (Resonance) in the Inertial Strategy}{14}{subsection.6.2}\protected@file@percent }
\newlabel{subsec:resonance_case}{{6.2}{14}{Case Study: Cyclic Synchronization (Resonance) in the Inertial Strategy}{subsection.6.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Visualization of a representative double-failure scenario. The Naive robot (cyan, $i_H = 1.230$) is permanently poisoned on the central L-shaped obstacle; the Inertial robot (green, $i_H = 0.167$) is caught in a Cyclic Synchronization (resonance) loop around the upper-right vertical obstacle because its passage across the top departure arc $\mathcal  {A}_L$ repeatedly coincides with the $10$-step adversarial active window; the Cautious robot (orange) pauses during bursts and arrives at the target in $137$ steps.}}{14}{figure.caption.4}\protected@file@percent }
\newlabel{fig:sim_trap}{{3}{14}{Visualization of a representative double-failure scenario. The Naive robot (cyan, $i_H = 1.230$) is permanently poisoned on the central L-shaped obstacle; the Inertial robot (green, $i_H = 0.167$) is caught in a Cyclic Synchronization (resonance) loop around the upper-right vertical obstacle because its passage across the top departure arc $\mathcal {A}_L$ repeatedly coincides with the $10$-step adversarial active window; the Cautious robot (orange) pauses during bursts and arrives at the target in $137$ steps}{figure.caption.4}{}}
