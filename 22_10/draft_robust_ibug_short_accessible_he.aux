\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces המחשת מלכודת התהודה (\foreignlanguage  {english}{Resonance}) בטענה~\ref {prop:resonance}: הקפת המכשול אורכת בדיוק $40$ צעדים — זהה למחזור ההבהוב של התוקף ($T_{\text  {cycle}}=40$). לכן, בכל סיבוב מחדש, התוקף נדלק ל-$10$ צעדים (הקטע האדום) בדיוק כשהרובוט האינרציאלי עובר בפינה העליונה הקרובה למטרה ($\mathcal  {A}_L$), והרובוט "מפספס את הרכבת" בכל הקפה מחדש.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:resonance_diagram}{{3}{5}{המחשת מלכודת התהודה (\foreignlanguage {english}{Resonance}) בטענה~\ref {prop:resonance}: הקפת המכשול אורכת בדיוק $40$ צעדים — זהה למחזור ההבהוב של התוקף ($T_{\text {cycle}}=40$). לכן, בכל סיבוב מחדש, התוקף נדלק ל-$10$ צעדים (הקטע האדום) בדיוק כשהרובוט האינרציאלי עובר בפינה העליונה הקרובה למטרה ($\mathcal {A}_L$), והרובוט "מפספס את הרכבת" בכל הקפה מחדש}{figure.caption.4}{}}
