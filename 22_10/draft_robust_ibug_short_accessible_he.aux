\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces המחשת פעולת מסנן האנומליות והאסטרטגיה הזהירה (\foreignlanguage  {english}{Cautious}) לאורך הזמן: בזמן הליכה רגילה העוצמה משתנה במתינות. ברגע שהתוקף נדלק נוצרת קפיצה אנכית חדה ($\mathcal  {A}_{\text  {spike}}$) שחורגת מהחסם הפיזיקלי $\Delta I_{\max }$. הרובוט הזהיר קופא במקום ונועל את זיכרונו עד שהוא מזהה את נפילת הכיבוי ($\mathcal  {A}_{\text  {drop}}$) ומאמת $N_{\text  {confirm}}=3$ צעדים נקיים. \textbf  {[לצפייה באנימציית הגילוי החיה מתוך הסימולציה: \href  {run:anomaly_filter_anim.gif}{לחצו כאן לפתיחת \foreignlanguage  {english}{anomaly\_filter\_anim.gif}} או פתחו את \href  {run:accessible_paper_online.html}{גרסת ה-\foreignlanguage  {english}{HTML} המקוונת}]}}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:anomaly_filter}{{2}{4}{המחשת פעולת מסנן האנומליות והאסטרטגיה הזהירה (\foreignlanguage {english}{Cautious}) לאורך הזמן: בזמן הליכה רגילה העוצמה משתנה במתינות. ברגע שהתוקף נדלק נוצרת קפיצה אנכית חדה ($\mathcal {A}_{\text {spike}}$) שחורגת מהחסם הפיזיקלי $\Delta I_{\max }$. הרובוט הזהיר קופא במקום ונועל את זיכרונו עד שהוא מזהה את נפילת הכיבוי ($\mathcal {A}_{\text {drop}}$) ומאמת $N_{\text {confirm}}=3$ צעדים נקיים. \textbf {[לצפייה באנימציית הגילוי החיה מתוך הסימולציה: \href {run:anomaly_filter_anim.gif}{לחצו כאן לפתיחת \foreignlanguage {english}{anomaly\_filter\_anim.gif}} או פתחו את \href {run:accessible_paper_online.html}{גרסת ה-\foreignlanguage {english}{HTML} המקוונת}]}}{figure.caption.3}{}}
