\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {(a)} פעולת אלגוריתם ה-\foreignlanguage  {english}{I-Bug} התקין: הרובוט צועד לכיוון העלייה בעוצמה (\foreignlanguage  {english}{\texttt  {MoveToTower}}), שומר את העוצמה $i_H$ בפגיעה בקיר, מקיף את המכשול (\foreignlanguage  {english}{\texttt  {FollowObstacle}}) עד שהוא מוצא שיא עוצמה $i_{\max } > i_H$ בפינה הקרובה למטרה, ועוזב לעבר המטרה. \textbf  {(b)} כאשר התוקף נדלק ($u(t)=1$), החיישן קולט את סכום שני המגדלים, ולכן כיוון העלייה התלולה ביותר ($\nabla _p S$) מוסת לכיוון הביניים וגורם לרובוט לסטות ממסלולו.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ibug_and_spoof}{{1}{2}{\textbf {(a)} פעולת אלגוריתם ה-\foreignlanguage {english}{I-Bug} התקין: הרובוט צועד לכיוון העלייה בעוצמה (\foreignlanguage {english}{\texttt {MoveToTower}}), שומר את העוצמה $i_H$ בפגיעה בקיר, מקיף את המכשול (\foreignlanguage {english}{\texttt {FollowObstacle}}) עד שהוא מוצא שיא עוצמה $i_{\max } > i_H$ בפינה הקרובה למטרה, ועוזב לעבר המטרה. \textbf {(b)} כאשר התוקף נדלק ($u(t)=1$), החיישן קולט את סכום שני המגדלים, ולכן כיוון העלייה התלולה ביותר ($\nabla _p S$) מוסת לכיוון הביניים וגורם לרובוט לסטות ממסלולו}{figure.caption.2}{}}
