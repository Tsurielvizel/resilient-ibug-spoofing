\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Visualizing Proposition~\ref {prop:resonance} (Topological Resonance): circling the obstacle takes $40$ steps—matching the attacker's $40$-step period. Every lap, the $10$-step spoofing burst (red arc) turns on right as the Inertial robot reaches the top-right exit corner $\mathcal  {A}_L$, blinding it to the departure peak on every revolution.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:resonance_diagram}{{3}{5}{Visualizing Proposition~\ref {prop:resonance} (Topological Resonance): circling the obstacle takes $40$ steps—matching the attacker's $40$-step period. Every lap, the $10$-step spoofing burst (red arc) turns on right as the Inertial robot reaches the top-right exit corner $\mathcal {A}_L$, blinding it to the departure peak on every revolution}{figure.caption.4}{}}
