\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {(a)} How benign I-Bug works: the robot walks uphill toward the beacon (\texttt  {MoveToTower}), records intensity $i_H$ upon hitting a wall, follows the perimeter (\texttt  {FollowObstacle}) until it detects a peak $i_{\max } > i_H$ at the corner closest to the beacon, and departs toward the goal. \textbf  {(b)} When the spoofing transmitter turns on ($u(t)=1$), the sensor observes the sum of both signals, deflecting the steepest-ascent gradient vector $\nabla _p S$ off course.}}{3}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:ibug_and_spoof}{{1}{3}{\textbf {(a)} How benign I-Bug works: the robot walks uphill toward the beacon (\texttt {MoveToTower}), records intensity $i_H$ upon hitting a wall, follows the perimeter (\texttt {FollowObstacle}) until it detects a peak $i_{\max } > i_H$ at the corner closest to the beacon, and departs toward the goal. \textbf {(b)} When the spoofing transmitter turns on ($u(t)=1$), the sensor observes the sum of both signals, deflecting the steepest-ascent gradient vector $\nabla _p S$ off course}{figure.caption.2}{}}
